# Development Mode Configuration
# Set to "true" to run without external dependencies (Redis, FastAPI backend)
NEXT_PUBLIC_DEV_MODE=true

# ============================================
# Optional: Redis Configuration (Production)
# ============================================
# For Upstash/Vercel KV (HTTP-based Redis):
# KV_REST_API_URL=https://your-redis-instance.upstash.io
# KV_REST_API_TOKEN=your_token_here

# For local TCP Redis:
# REDIS_URL=redis://localhost:6379

# ============================================
# Optional: Backend API Configuration
# ============================================
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ============================================
# Optional: JWT Configuration
# ============================================
# JWT_SECRET=your-32-character-secret-key-here

# ============================================
# Optional: LLM API Keys (Production)
# ============================================
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ELEVENLABS_API_KEY=your_elevenlabs_key
