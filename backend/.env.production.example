# Production Environment Configuration Template
# SECURITY: Never commit this file with actual values to version control
# Copy this to .env.production and fill in your actual production values

# ===== OPERATIONAL MODE =====
DEMO_MODE=false
NODE_ENV=production

# ===== SERVER CONFIGURATION =====
PROJECT_NAME=Vidya Vaani
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# ===== FRONTEND URLS =====
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# ===== REQUIRED: GEMINI AI API =====
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_production_gemini_api_key_here

# ===== REQUIRED: SUPABASE CONFIGURATION =====
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ===== STORAGE CONFIGURATION =====
# S3 or S3-compatible storage (e.g., Supabase Storage, AWS S3)
S3_BUCKET_NAME=vidya-vaani-documents
S3_ENDPOINT=https://your-project.supabase.co/storage/v1
S3_REGION=us-east-1

# ===== REDIS CONFIGURATION =====
# Use Upstash Redis for serverless or your own Redis instance
REDIS_ENABLED=true
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TLS=true

# ===== RASA NLU CONFIGURATION =====
RASA_API_URL=http://localhost:5005
RASA_ENABLED=true

# ===== SECURITY =====
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=generate_a_strong_random_secret_key_here
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ===== MONITORING =====
ENABLE_METRICS=true
ENABLE_TRACING=true

# ===== TRANSLATION SERVICE =====
# For production, set to 'marian' or 'google'
TRANSLATION_PROVIDER=marian
GOOGLE_TRANSLATE_API_KEY=

# ===== DATABASE =====
# For production RAG with pgvector (optional, FAISS is default)
USE_PGVECTOR=false
POSTGRES_CONNECTION_STRING=
